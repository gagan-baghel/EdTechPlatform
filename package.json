{
  "name": "edtechplatform-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "migrate:indexes": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/.bin/tsx scripts/ensure-indexes.ts",
    "migrate:content-order": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/.bin/tsx scripts/backfill-content-order.ts",
    "verify:restore": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/.bin/tsx scripts/verify-restore.ts"
  },
  "dependencies": {
    "@ramonak/react-progress-bar": "^5.2.0",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.6.3",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "copy-to-clipboard": "^3.3.3",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "next": "^16.3.0",
    "next-intl": "^4.13.6",
    "nodemailer": "^9.0.5",
    "otp-generator": "^4.0.1",
    "razorpay": "^2.9.2",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.3",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.8.0",
    "react-markdown": "^9.0.1",
    "react-otp-input": "^3.1.1",
    "react-redux": "^9.3.0",
    "react-super-responsive-table": "^6.0.2",
    "react-type-animation": "^3.0.1",
    "swiper": "^14.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
