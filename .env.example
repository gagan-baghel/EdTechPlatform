# Backend
MONGODB_CONNECTION_URL=""
MAIL_HOST="smtp.gmail.com"
MAIL_USER=""
MAIL_PASS=""
JWT_SECRET=""
FOLDER_NAME=""
RAZORPAY_KEY=""
RAZORPAY_SECRET=""
# Razorpay webhook signing secret. Set this in the Razorpay dashboard under
# Settings > Webhooks, pointing at POST /api/v1/payment/webhook with the
# "payment.captured" event. This is the authoritative enrolment path — it is
# what makes a purchase survive the user closing the tab mid-checkout.
# Without it the webhook rejects every delivery.
WEBHOOK_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# REQUIRED IN PRODUCTION.
# Password-reset links are built from this instead of the request Host header,
# so an attacker cannot point a victim's reset link at their own domain.
# Without it, password reset returns a 500 in production.
# Example: https://intellecraft.vercel.app
APP_BASE_URL=""

# Frontend (Next.js)
# REQUIRED. Baked into the client bundle at BUILD time, so it must be set in the
# hosting environment before the build runs, not just at runtime.
# There is deliberately no fallback — a missing key disables checkout loudly
# rather than silently charging against a test key.
NEXT_PUBLIC_RAZORPAY_KEY=""
