# Backend
MONGODB_CONNECTION_URL=""
MAIL_HOST="smtp.gmail.com"
MAIL_USER=""
MAIL_PASS=""
JWT_SECRET=""
FOLDER_NAME=""
RAZORPAY_KEY=""
RAZORPAY_SECRET=""
# Razorpay webhook signing secret. Set this in the Razorpay dashboard under
# Settings > Webhooks, pointing at POST /api/v1/payment/webhook with the
# "payment.captured" event. This is the authoritative enrolment path — it is
# what makes a purchase survive the user closing the tab mid-checkout.
# Without it the webhook rejects every delivery.
WEBHOOK_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# REQUIRED IN PRODUCTION.
# Password-reset links are built from this instead of the request Host header,
# so an attacker cannot point a victim's reset link at their own domain.
# Without it, password reset returns a 500 in production.
# Example: https://intellecraft.vercel.app
APP_BASE_URL=""

# Support address shown in every transactional email (OTP, password change,
# enrolment, payment receipt). Falls back to support@intellecraft.com if unset.
SUPPORT_EMAIL=""

# Enables POST /api/v1/auth/bootstrap-admin, the only way to create an Admin
# account (signup always rejects accountType: "Admin"). Set this, sign up a
# normal account, then:
#   curl -X POST https://<your-domain>/api/v1/auth/bootstrap-admin \
#     -H "x-setup-key: <this value>" -H "Content-Type: application/json" \
#     -d '{"email":"you@example.com"}'
# Leave unset to disable the route entirely (it 404s when this is unset).
# Categories are required before any course can be created and can only be
# added via POST /api/v1/course/createCategory with the resulting admin's JWT.
ADMIN_SETUP_KEY=""

# Vercel sets this automatically for projects with a crons entry in
# vercel.json (Project Settings > Environment Variables > System). Required
# for POST /api/v1/cron/publish-scheduled (scheduled course publishing) —
# without it the endpoint refuses every request, including Vercel's own.
CRON_SECRET=""

# REQUIRED IN PRODUCTION.
# Encrypts instructor bank account numbers at rest (AES-256-GCM; see
# src/api/lib/crypto.ts). There is deliberately no fallback: without this set,
# the payout-profile endpoints fail loudly rather than storing real bank
# details under a key that is public in this repository.
# Generate one with:  openssl rand -base64 48
FIELD_ENCRYPTION_KEY=""

# Optional. Only read when APP_BASE_URL is unset — APP_BASE_URL is preferred
# because it is server-only, whereas this is inlined into the client bundle.
NEXT_PUBLIC_SITE_URL=""

# AI features (transcription, tutor, instructor copilot) — all optional.
# Every AI endpoint checks for these at call time and returns a clear
# "not configured" response rather than an opaque error when they're unset;
# the rest of the platform works fully without them.
#
# Transcription (Whisper) specifically needs OpenAI — Anthropic has no
# speech-to-text API. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Powers the lecture tutor and instructor authoring copilot.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=""

# Frontend (Next.js)
# REQUIRED. Baked into the client bundle at BUILD time, so it must be set in the
# hosting environment before the build runs, not just at runtime.
# There is deliberately no fallback — a missing key disables checkout loudly
# rather than silently charging against a test key.
NEXT_PUBLIC_RAZORPAY_KEY=""
